#!/usr/bin/env bash
# Pre-commit GATE for jsolly (gate-only — this hook does NOT deploy).
#
# Thin shim over the shared fleet gate library (dotagents/gate/gate-lib.sh): the
# staged secrets scan, markdown-lint-on-change, the doc-only fast path, the
# commit-context guards, and run_step (silent on green, full output on red) live
# in the lib. This file declares only jsolly-specific quality steps.
set -euo pipefail

# shellcheck source=/dev/null
source "${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}" || {
  echo "✗ dotagents gate-lib not found (expected ~/code/dotagents/gate/gate-lib.sh) — re-run install-local-agent-runtime.sh." >&2
  exit 1
}
# Gate the tree being committed, not this copy's: under an absolute core.hooksPath (Claude
# desktop worktrees) this re-execs the committing tree's own hook; it sets ROOT and cd's.
gate_enter_committing_tree "${BASH_SOURCE[0]}"
gate_require_lib 12  # gate_check_bash_floor

gate_begin_commit "jsolly"    # staged gitleaks; md-lint; doc-only fast path; skip on merge/amend; banner; ERR trap
run_step "bash floor" gate_check_bash_floor   # every Bash entrypoint refuses Bash < 5
gate_require_node              # enforce the pinned Node (.nvmrc), not whatever's on PATH

# --- Quality gate (run_step: silent on green, full output + abort on red) ---
run_step "actionlint"    npm run check:actions
run_step "markdown lint" npm run check:md       # whole tree: the lib lints only when .md is staged

echo "✓ pre-commit gate passed — commit will land; no deploy (gate-only)."
